# Backend origin used by the browser for POST /chat.
# Inlined at build time by Next.js -- changing it requires a redeploy, not a restart.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Backend origin used server-side by the /api/auth/* proxy routes.
# Falls back to NEXT_PUBLIC_API_BASE, then to http://127.0.0.1:8000.
BACKEND_URL=http://127.0.0.1:8000

# Optional client-side debug logging
# NEXT_PUBLIC_DEBUG_SESSION=1
# NEXT_PUBLIC_DEBUG_NAV=1
